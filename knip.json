{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["*.config.{js,ts}", "vitest.mutation.setup.ts"]
    },
    "apps/desktop": {
      "entry": ["e2e/**/*.spec.ts"],
      "project": ["src/**/*.ts", "e2e/**/*.ts"]
    },
    "scripts": {
      "entry": ["src/bin/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@stryker-mutator/command-runner"]
}
