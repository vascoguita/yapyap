[Desktop Entry]
Type=Application
Name=YapYap
GenericName=Messaging client
Comment=Desktop client for WhatsApp Web (unofficial)
Exec=yapyap %U
Icon=org.guita.YapYap
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=whatsapp;chat;messaging;
StartupWMClass=org.guita.YapYap
MimeType=x-scheme-handler/whatsapp;
StartupNotify=true
Actions=SafeMode;

[Desktop Action SafeMode]
Name=Start in Safe Mode
Exec=yapyap --safe-mode
