# Dependencies and local environment
node_modules/
.env
.env.*
!.env.example
*.log
.eslintcache

# Build output
out/
dist/
apps/*/release/
extensions-out/
*.tsbuildinfo
# Vite bundles its config next to it while loading it.
*.timestamp-*.mjs
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/api/
# Copied from the app and the SDK by the docs build.
docs/public/logo.svg
docs/public/schema/

# Test, coverage and mutation reports
coverage/
playwright-report/
test-results/
reports/
.stryker-tmp/

# Packaging and signing
*.yapyap-extension
*.pem
!**/test/**/fixtures/**/*.pem
.flatpak-builder/
flatpak-build/
*.flatpak

# Editor settings stay personal; the repository shares none.
.vscode/

# Local coding-agent state, such as its worktrees: copies of this repository.
.claude/
