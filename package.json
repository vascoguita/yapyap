{
  "name": "yapyap-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter @yapyap/desktop dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint --max-warnings=0 . && prettier --check . && knip",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "commitlint": "commitlint --from origin/master --to HEAD --verbose",
    "test:e2e": "pnpm --filter \"./plugins/**\" build && pnpm --filter @yapyap/desktop test:e2e",
    "check:licenses": "pnpm --filter @yapyap/scripts check-licenses",
    "test:mutation": "stryker run",
    "docs:dev": "pnpm --filter @yapyap/docs dev",
    "docs:build": "pnpm --filter @yapyap/docs build",
    "package": "pnpm --filter @yapyap/desktop build && node scripts/src/bin/package.ts",
    "test:smoke": "pnpm --filter @yapyap/desktop test:smoke",
    "test:bench": "pnpm --filter @yapyap/desktop test:bench"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
