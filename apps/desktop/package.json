{
  "name": "@yapyap/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "YapYap desktop app",
  "license": "MIT",
  "author": "Vasco Guita",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p src/adapter/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:e2e": "electron-vite build && playwright test --project e2e",
    "builder": "electron-builder",
    "test:smoke": "playwright test --project smoke",
    "test:bench": "electron-vite build && playwright test --project bench",
    "screenshots": "playwright test --project=screenshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/preact": "3.2.6",
    "@wllama/wllama": "3.8.1",
    "@yapyap/extension-sdk": "workspace:*",
    "@yapyap/extension-sign": "workspace:*",
    "axe-core": "4.14.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "vite": "8.3.5"
  },
  "productName": "YapYap",
  "desktopName": "org.guita.YapYap.desktop",
  "main": "./out/main/index.js",
  "homepage": "https://yapyap.guita.org/",
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "electron-updater": "6.8.11",
    "openai": "7.43.0",
    "preact": "11.0.2",
    "typebox": "1.4.3"
  }
}
