{
  "name": "@yapyap/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "YapYap desktop app",
  "license": "MIT",
  "author": "Vasco Guita",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p src/adapter/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:e2e": "electron-vite build && playwright test --project e2e",
    "builder": "electron-builder",
    "test:smoke": "playwright test --project smoke",
    "test:bench": "electron-vite build && playwright test --project bench"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/preact": "3.2.4",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.3",
    "vite": "8.3.4"
  },
  "productName": "YapYap",
  "desktopName": "org.guita.YapYap.desktop",
  "main": "./out/main/index.js",
  "homepage": "https://yapyap.guita.org/",
  "dependencies": {
    "electron-updater": "6.8.9",
    "preact": "11.0.1",
    "typebox": "1.4.2"
  }
}
