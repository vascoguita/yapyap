{
  "name": "yapyap-extension-template",
  "version": "0.1.0",
  "private": true,
  "description": "A YapYap extension",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "sign": "yapyap-extension-sign sign --key signing-key.pem dist",
    "verify": "yapyap-extension-sign verify dist"
  },
  "devDependencies": {
    "@yapyap/extension-sdk": "0.1.0",
    "@yapyap/extension-sign": "0.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
