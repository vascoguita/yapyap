{
  "id": "org.guita.yapyap.call-recorder",
  "name": "Call recorder",
  "version": "0.1.1",
  "description": "Records your WhatsApp calls on this computer, only after you click Record in YapYap and confirm that everyone on the call agrees.",
  "author": {
    "name": "YapYap",
    "url": "https://yapyap.guita.org"
  },
  "apiVersion": "^1.0.0",
  "entry": "main.js",
  "activation": "on-demand",
  "capabilities": [
    "calls:record"
  ],
  "network": {
    "hosts": []
  },
  "contributes": {
    "commands": [
      {
        "id": "record",
        "title": "Record this call",
        "shortcut": "CmdOrCtrl+Alt+R"
      },
      {
        "id": "stop",
        "title": "Stop recording",
        "shortcut": "CmdOrCtrl+Alt+S"
      }
    ],
    "panel": {
      "title": "Recordings",
      "entry": "panel.js"
    }
  }
}
