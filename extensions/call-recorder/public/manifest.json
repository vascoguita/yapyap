{
  "id": "org.guita.yapyap.call-recorder",
  "name": "Call recorder",
  "version": "0.1.0",
  "description": "Records your WhatsApp calls on this computer, only after you click Record in YapYap and confirm that everyone on the call agrees.",
  "author": { "name": "YapYap", "url": "https://yapyap.guita.org" },
  "apiVersion": "^1.0.0",
  "entry": "main.js",
  "capabilities": ["calls:record"],
  "network": { "hosts": [] },
  "contributes": {
    "commands": [
      { "id": "record", "title": "Record this call" },
      { "id": "stop", "title": "Stop recording" }
    ],
    "panel": { "title": "Recordings", "entry": "panel.js" }
  }
}
