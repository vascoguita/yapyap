{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../packages/sdk/src/index.ts"],
  "tsconfig": "../packages/sdk/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "api",
  "readme": "none",
  "entryFileName": "index",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "excludePrivate": true,
  "treatWarningsAsErrors": true,
  "disableSources": true
}
