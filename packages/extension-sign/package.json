{
  "name": "@yapyap/extension-sign",
  "version": "0.0.0",
  "description": "Ed25519 signing, verification and trust decisions for YapYap extensions",
  "keywords": [
    "yapyap",
    "extension",
    "ed25519",
    "signing"
  ],
  "homepage": "https://yapyap.guita.org/extensions/#sign-it",
  "bugs": "https://github.com/vascoguita/yapyap/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vascoguita/yapyap.git",
    "directory": "packages/extension-sign"
  },
  "license": "MIT",
  "author": "Vasco Guita",
  "type": "module",
  "bin": {
    "yapyap-extension-sign": "src/bin/yapyap-extension-sign.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "yapyap-extension-sign": "dist/bin/yapyap-extension-sign.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
